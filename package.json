{
  "name": "cartoon-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Paper-puppet cartoons for one boy's iPad (landscape), in torn paper. Written by Claude Code from repo skills.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "shots": "tsx scripts/shots.mjs",
    "check": "tsx scripts/check-cartoon.ts",
    "voice:export": "tsx scripts/voice/export.ts",
    "voice:cast": "tsx scripts/voice/cast-check.ts",
    "new": "tsx scripts/new-cartoon.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "gsap": "^3.15.0"
  }
}
